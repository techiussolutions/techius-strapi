{
  "kind": "collectionType",
  "collectionName": "case_studies",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "Case Study",
    "description": "Client work and portfolio projects"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "num": { "type": "string" },
    "year": { "type": "string" },
    "tag": { "type": "string" },
    "category": { "type": "string" },
    "services": { "type": "string" },
    "description": { "type": "text", "required": true },
    "subtitle": { "type": "text" },
    "lead": { "type": "text" },
    "challenge": {
      "type": "component",
      "component": "sections.text-section",
      "repeatable": false
    },
    "solution": {
      "type": "component",
      "component": "sections.text-section",
      "repeatable": false
    },
    "body3": {
      "type": "component",
      "component": "sections.text-section",
      "repeatable": false
    },
    "bullets": {
      "type": "component",
      "component": "sections.bullet-item",
      "repeatable": true
    },
    "impact": {
      "type": "component",
      "component": "sections.impact-stat",
      "repeatable": true
    },
    "nextTitle": { "type": "string" },
    "nextHref": { "type": "string" },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
